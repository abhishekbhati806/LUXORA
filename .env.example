# LUXORA — example environment. Copy to .env (repo root or server/) and fill in.
# Never commit a real .env. Generate secrets with:  openssl rand -hex 32

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/luxora

# ── Auth (REQUIRED in production; dev falls back to ephemeral keys) ────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
COOKIE_NAME=luxora_refresh

# ── CORS / cookies ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=25

# ── Media: local fallback storage, Cloudinary when configured ──────────────
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=8
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=luxora/hotels

# ── Seed/demo accounts (change these in any shared deployment) ─────────────
SEED_ADMIN_EMAIL=admin@luxora.travel
SEED_ADMIN_PASSWORD=LuxoraAdmin#26
SEED_DEMO_EMAIL=aarav@me.com
SEED_DEMO_PASSWORD=LuxoraGuest#26

# ── Server also serves client/dist when it exists (single-origin deploy) ──
SERVE_CLIENT=true
LOG_FORMAT=dev

# ── Client (Vite picks these up from client/.env.*) ────────────────────────
# Leave VITE_API_URL empty to use same-origin /api/v1 (dev proxy handles it).
VITE_API_URL=
# Optional CDN root for imagery; empty uses /img/* from client/public.
VITE_IMAGE_CDN=
